APP_ENV=development
HTTP_PORT=8080

DATABASE_URL=postgres://notifyhub:notifyhub@localhost:5432/notifyhub?sslmode=disable
REDIS_URL=redis://localhost:6379/0

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=notifications.send
KAFKA_GROUP_ID=notifyhub-worker

# Gmail SMTP (use an App Password, not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com
